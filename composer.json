{
  "name": "contenir/contenir-maintenance-laminas-mvc",
  "description": "Laminas MVC adapter for contenir/contenir-maintenance — short-circuits dispatch with 503 when maintenance mode is active.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
    "contenir/contenir-maintenance": "^2.1",
    "laminas/laminas-eventmanager": "^3.13",
    "laminas/laminas-http": "^2.19",
    "laminas/laminas-mvc": "^3.7",
    "laminas/laminas-servicemanager": "^3.22 || ^4.0",
    "psr/container": "^1.1 || ^2.0"
  },
  "require-dev": {
    "contenir/contenir-qa-tools": "0.1.x-dev",
    "infection/infection": "^0.34.1",
    "phpunit/phpunit": "^11.5.42"
  },
  "replace": {
    "contenir/maintenance-laminas-mvc": "self.version"
  },
  "autoload": {
    "psr-4": {
      "Contenir\\Maintenance\\Laminas\\Mvc\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Contenir\\Maintenance\\Laminas\\Mvc\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "check": [
      "@cs-check",
      "@static-analysis",
      "@test",
      "@test-integration",
      "@mutation-test"
    ],
    "cs-check": [
      "mago format --check",
      "mago lint"
    ],
    "cs-fix": [
      "mago format",
      "mago lint --fix"
    ],
    "static-analysis": "mago analyze",
    "test": "phpunit --colors=always --testsuite unit",
    "test-integration": "phpunit --colors=always --testsuite integration",
    "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
    "mutation-test": "infection"
  },
  "config": {
    "platform": {
      "php": "8.3.99"
    },
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "2.2.x-dev"
    },
    "laminas": {
      "module": "Contenir\\Maintenance\\Laminas\\Mvc"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
